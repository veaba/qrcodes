# 统一行尾与文本处理
#
# 背景：本仓库曾出现 197 个 CRLF、41 个 LF 的混用状态，导致
#   - git 反复警告 "LF will be replaced by CRLF"
#   - 跨平台 diff 出现整文件噪声
#   - 同一文件在不同系统上产生不同的 blob
#
# 规则：仓库内一律使用 LF。Windows 开发者无需依赖 core.autocrlf。

# 默认：所有文本文件统一 LF
* text=auto eol=lf

# 显式声明为文本（避免被误判为二进制）
*.md        text eol=lf
*.mdx       text eol=lf
*.json      text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.mjs       text eol=lf
*.cjs       text eol=lf
*.rs        text eol=lf
*.toml      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf

# Windows 专用脚本保留 CRLF（如有）
*.bat       text eol=crlf
*.cmd       text eol=crlf

# 二进制文件：不做任何转换
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.webp      binary
*.wasm      binary
*.woff      binary
*.woff2     binary

# 锁文件：标记为二进制，避免 diff 噪声与合并冲突展开
pnpm-lock.yaml  -diff linguist-generated
Cargo.lock      -diff linguist-generated

# 构建产物与依赖：不在语言统计中显示
doc_build/**    linguist-generated
target/**       linguist-generated
node_modules/** linguist-generated
dist/**         linguist-generated
pkg/**          linguist-generated
