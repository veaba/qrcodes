{
  "name": "@veaba/qrcodes-monorepos",
  "version": "0.0.1-alpha",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "clean": "node scripts/clean.js",
    "watch": "pnpm rsw watch",
    "build": "pnpm -r --filter './packages/*' run build",
    "build:js": "pnpm --filter @veaba/qrcode-js-shared build && pnpm --filter @veaba/qrcode-js build",
    "build:node": "pnpm --filter @veaba/qrcode-js-shared build && pnpm --filter @veaba/qrcode-node build",
    "build:wasm": "pnpm --filter @veaba/qrcode-wasm build",
    "build:rust": "pnpm --filter @veaba/qrcode-fast build && pnpm --filter @veaba/qrcode-rust build",
    "rsw": "rsw",
    "test": "node scripts/test.js",
    "test:unit": "node scripts/test.js",
    "test:browser": "node scripts/test.js --browser",
    "test:browser:ui": "node scripts/test.js --browser --headed",
    "test:watch": "node scripts/test.js --watch",
    "test:coverage": "node scripts/test.js --coverage && node scripts/fix-coverage-paths.js",
    "test:coverage:bun": "bun test tests/qrcode-bun/ --coverage --coverage-reporter=lcov --coverage-dir=coverage/bun && node scripts/fix-coverage-paths.js --file coverage/bun/lcov.info",
    "test:shared": "node scripts/test.js --shared",
    "test:js": "node scripts/test.js --js",
    "test:node": "node scripts/test.js --node",
    "test:wasm": "node scripts/test.js --wasm",
    "test:bun": "node scripts/test.js --bun",
    "benchmark": "node bench/scripts/run.js",
    "benchmark:backend": "node bench/scripts/run.js",
    "benchmark:node": "node bench/scripts/run.js --node",
    "benchmark:bun": "node bench/scripts/run.js --bun",
    "benchmark:rust": "node bench/scripts/run.js --rust",
    "bench:svg": "node bench/svg-benchmark/index.js",
    "bench:svg:five-way": "node bench/svg-benchmark/collect-five-way.mjs",
    "bench:svg:gen": "node bench/svg-benchmark/gen-and-validate-svg.mjs",
    "bench:svg:gen:all": "node bench/svg-benchmark/gen-and-validate-svg.mjs --all",
    "bench:svg:validate": "cargo run --release --features validation --bin validate-svg-dir --manifest-path bench/rust-tools/Cargo.toml",
    "bench:svg:rust": "node bench/svg-benchmark/rust.js",
    "bench:svg:rust:quick": "node bench/svg-benchmark/rust.js --quick",
    "bench:svg:rust:full": "node bench/svg-benchmark/rust.js",
    "bench:svg:js": "node bench/svg-benchmark/node-bun.js",
    "bench:svg:js:node": "node bench/svg-benchmark/node-bun.js --node",
    "bench:svg:js:bun": "node bench/svg-benchmark/node-bun.js --bun",
    "bench:svg:quick": "node bench/svg-benchmark/index.js --quick",
    "bench:svg:full": "node bench/svg-benchmark/index.js --full",
    "publish:check": "node scripts/publish-check.js",
    "publish:all": "node scripts/publish.js",
    "publish:dry-run": "node scripts/publish.js --dry-run",
    "publish:help": "echo '查看 PUBLISH.md 获取详细发包指南'",
    "docs:dev": "rspress dev",
    "docs:build": "rspress build",
    "docs:preview": "rspress preview",
    "changeset": "changeset",
    "changeset:add": "changeset add",
    "changeset:status": "changeset status",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "version:sync": "node scripts/sync-cargo-version.js",
    "ci:version": "changeset version && pnpm run version:sync && pnpm install",
    "ci:publish": "changeset publish",
    "clippy": "cargo clippy --fix",
    "fmt:rust": "cargo fmt --all",
    "check:perf-claims": "node scripts/check-perf-claims.js",
    "check:hygiene": "node scripts/check-repo-hygiene.js",
    "check:rs-blocks": "node scripts/check-rs-blocks.js",
    "check:all": "node scripts/check-perf-claims.js && node scripts/check-repo-hygiene.js && node scripts/check-rs-blocks.js",
    "verify:speedup": "cargo run --release --bin verify-speedup --manifest-path bench/rust-tools/Cargo.toml",
    "verify:capability": "cargo run --release --features validation --bin scan-max --manifest-path bench/rust-tools/Cargo.toml",
    "verify:qr-validity": "cargo test --release --features validation --test qr_validity --manifest-path bench/rust-tools/Cargo.toml"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@types/node": "^25.1.0",
    "@vitest/browser": "^2.1.9",
    "@vitest/coverage-v8": "^2.1.0",
    "playwright": "^1.58.1",
    "rimraf": "^6.0.1",
    "typescript": "^4.8.4",
    "vite": "^5.0.0",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@rspress/core": "^2.0.23"
  },
  "packageManager": "pnpm@12.11.2",
  "workspaces": [
    "packages/*"
  ]
}
